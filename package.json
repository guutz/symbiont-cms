{
	"name": "symbiont-cms",
	"version": "1.1.8",
	"description": "A flexible CMS package for SvelteKit apps with Notion and database sync.",
	"license": "LGPL-3.0-only",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"files": [
		"dist",
		"src",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!src/**/*.test.*",
		"!src/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"engines": {
		"node": ">=18.18.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.57.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/markdown-it": "14.2.0",
		"@types/node": "^26.4.1",
		"@types/prismjs": "1.26.6",
		"@vitest/coverage-v8": "5.0.0",
		"dotenv": "^17.4.2",
		"pino-pretty": "^13.1.3",
		"publint": "^0.3.24",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vite": "^8.2.2",
		"vitest": "5.0.0"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@mdit/plugin-abbr": "1.1.0",
		"@mdit/plugin-attrs": "1.3.0",
		"@mdit/plugin-embed": "1.1.0",
		"@mdit/plugin-figure": "1.2.0",
		"@mdit/plugin-footnote": "1.1.0",
		"@mdit/plugin-img-lazyload": "1.1.0",
		"@mdit/plugin-img-size": "1.1.0",
		"@mdit/plugin-katex": "1.1.0",
		"@mdit/plugin-mark": "2.1.0",
		"@mdit/plugin-spoiler": "2.1.0",
		"@mdit/plugin-sub": "1.1.0",
		"@mdit/plugin-sup": "1.1.0",
		"@mdit/plugin-tasklist": "1.1.0",
		"@notionhq/client": "5.26.0",
		"@supabase/supabase-js": "^2.115.0",
		"graphql": "17.0.2",
		"graphql-request": "7.4.0",
		"gray-matter": "4.0.3",
		"image-size": "^2.0.2",
		"katex": "0.18.7",
		"markdown-it": "15.0.1",
		"pino": "^10.3.1",
		"prismjs": "1.30.0",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"slugify": "1.6.9",
		"unified": "11.0.5"
	},
	"packageManager": "pnpm@11.22.0"
}
