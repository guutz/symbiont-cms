{
  // Standalone. This used to `extend ./.svelte-kit/tsconfig.json`, a file
  // generated by `svelte-kit sync` -- which meant type-checking could not run
  // until SvelteKit had been invoked, and dragged the whole SvelteKit toolchain
  // into a package that contains no .svelte files and exports no components.
  //
  // Settings below are carried over from what the generated config provided:
  //   verbatimModuleSyntax  the source is written with explicit `import type`
  //   isolatedModules       each file must be transpilable on its own
  //   DOM libs              server code references fetch/Request/Response/
  //                         Headers/HeadersInit, which live in the DOM lib
  //
  // Changed deliberately:
  //   module/moduleResolution are NodeNext, not bundler/esnext. Consumers load
  //   this from Node (SvelteKit SSR, Vercel functions, plain scripts), not
  //   through a bundler that resolves extensionless specifiers. Every relative
  //   import in src already carries a .js extension, so NodeNext emits output
  //   Node can load directly.
  //
  // This config is for type-checking and editors (noEmit). The build uses
  // tsconfig.build.json, which excludes tests and turns emit on.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["src/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
